FROM python:3.12-slim
ENV DEFAULT_PROVIDER=gemini
WORKDIR /app
COPY pyproject.toml ./
COPY app ./app
COPY benchmark ./benchmark
COPY deploy ./deploy
RUN pip install --no-cache-dir '.[gemini]' \
    && useradd --system --uid 10001 receipt
ENV PUBLIC_DEPLOYMENT=true
USER receipt
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
