# Copy to .env. Do not commit credentials or include .env in reports.
# Verified model identifiers are a dated inventory, not a future availability promise.
DEFAULT_PROVIDER=ocr_nvidia
# Use1 for the estimated4GB OCR machine; up to4 on a machine with sufficient RAM.
MAX_IN_FLIGHT=4
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local Tesseract uses Arabic + English. Both traineddata files must be present.
OCR_ENGINE=paddle
# Optional absolute path; unset uses this repository's data/tessdata.
# TESSDATA_PREFIX=/absolute/path/to/tessdata
# Only relevant to Paddle API requests; benchmark uses corpus language labels.
# OCR_LANGUAGE=ar

# Empty key is allowed only on an intentionally local, private API.
API_KEY=
PUBLIC_DEPLOYMENT=false

# Modal client points at the FULL extraction route, not just the service origin.
MODAL_ENDPOINT=
MODAL_API_KEY=
# Initial candidate; development evidence must determine the selected model.
MODAL_MODEL_ID=zai-org/GLM-OCR
MODAL_GPU=T4
MODAL_CPU=2
MODAL_MEMORY_MIB=8192

# Optional free OpenRouter comparison; free quota and shared capacity are limited.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
